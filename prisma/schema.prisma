generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("TURSO_DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String?   @unique 
  phone         String?   @unique 
  passwordHash  String?   @map("password_hash") 
  status        String    @default("active")
  role          String    @default("STUDENT")
  
  // --- اطلاعات آکادمیک جدید ---
  name          String?   
  age           Int?      
  major         String?   
  university    String?   
  degree        String?   

  // --- فیلدهای امنیتی ---
  emailVerified DateTime? @map("email_verified")
  phoneVerified DateTime? @map("phone_verified")
  
  // --- فیلدهای بازیابی رمز عبور ---
  resetToken    String?   @unique @map("reset_token")
  resetTokenExpiry DateTime? @map("reset_token_expiry")

  createdAt     DateTime  @default(now()) @map("created_at")
  
  recordings    Recording[]
  auditLogs     AuditLog[]
  subscription  Subscription? 
  transactions  Transaction[]
  
  // <--- این خط را به اینجا منتقل کردم (قبل از @@map) --->
  researchOptIn Boolean @default(false) @map("research_opt_in")

  @@map("users")
}

model Recording {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  title           String
  language        String?
  durationSeconds Int?     @map("duration_seconds")
  storageKey      String   @map("storage_key")
  status          String   @default("uploaded")
  createdAt       DateTime @default(now()) @map("created_at")

  user            User                @relation(fields: [userId], references: [id])
  jobs            ProcessingJob[]
  segments        TranscriptSegment[]
  notes           Note[]
  photos          Photo[]

  @@index([userId, createdAt(sort: Desc)])
  @@map("recordings")
}

model Subscription {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  plan      String   @default("FREE")
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id])

  @@map("subscriptions")
}

model Transaction {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  amount    Int      
  authority String?  
  refId     String?  @map("ref_id")
  status    String   @default("PENDING") 
  plan      String   
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id])

  @@map("transactions")
}

model Photo {
  id          String   @id @default(uuid())
  recordingId String   @map("recording_id")
  storageKey  String   @map("storage_key")
  capturedAtSeconds Float? @map("captured_at_seconds")
  createdAt   DateTime @default(now()) @map("created_at")

  recording   Recording @relation(fields: [recordingId], references: [id])

  @@map("photos")
}

model ProcessingJob {
  id          String   @id @default(uuid())
  recordingId String   @map("recording_id")
  jobType     String   @map("job_type")
  status      String   @default("queued")
  priority    Int      @default(5)
  attempts    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  recording   Recording @relation(fields: [recordingId], references: [id])

  @@index([status, priority])
  @@map("processing_jobs")
}

model TranscriptSegment {
  id          String   @id @default(uuid())
  recordingId String   @map("recording_id")
  speakerId   String?  @map("speaker_id")
  startTime   Float    @map("start_time")
  endTime     Float    @map("end_time")
  text        String

  recording   Recording @relation(fields: [recordingId], references: [id])

  @@map("transcript_segments")
}

model Note {
  id              String   @id @default(uuid())
  recordingId     String   @unique @map("recording_id")
  title           String?
  content         String   
  originalContent String   @map("original_content")
  chatMessages ChatMessage[] 
  
  contentJson     String?  @map("content_json")     // <-- این خط باید باشد
  schemaVersion   String   @default("1.0.0") @map("schema_version")  // <-- این خط هم
  
  version         Int      @default(1)
  shareToken      String?  @unique @map("share_token")
  createdAt       DateTime @default(now()) @map("created_at")

  recording       Recording @relation(fields: [recordingId], references: [id])

  @@map("notes")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  action    String
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model ChatMessage {
  id        String   @id @default(uuid())
  noteId    String   @map("note_id")
  role      String
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}